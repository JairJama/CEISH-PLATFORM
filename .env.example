# ============================================================================
# CEISH Platform — Variables de entorno
# Copia este archivo a `.env` y ajusta los valores si es necesario.
# ============================================================================

# Conexión para Prisma al ejecutar NestJS en el host. En Compose se usa el host postgres:5432.
DATABASE_URL=postgresql://ceish_user:ceish_pass@localhost:5433/ceish_db?schema=public
DATABASE_HOST=localhost
# 5433 en el host para no chocar con una instalación local de PostgreSQL
# (que suele ocupar el 5432). Dentro de Docker el contenedor sigue en 5432.
DATABASE_PORT=5433
DATABASE_NAME=ceish_db
DATABASE_USER=ceish_user
DATABASE_PASSWORD=ceish_pass

# Clave HMAC para la cookie de sesión. Reemplázala por un valor aleatorio de 32+ caracteres.
SESSION_SECRET=replace-with-a-long-random-secret

# Usa la API NestJS (en vez del plugin transitorio de Vite).
VITE_USE_NEST_BACKEND=true
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
APP_PORT=3000
NODE_ENV=development

# MinIO — object storage para los documentos PDF.
# El middleware del servidor Vite sube y firma URLs; el navegador solo recibe URLs.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false
# Tamaño máximo permitido por archivo (MB)
UPLOAD_MAX_MB=15
