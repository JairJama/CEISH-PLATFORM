# ============================================================================
# CEISH Platform — Variables de entorno
# Copia este archivo a `.env` y ajusta los valores si es necesario.
# ============================================================================

# Conexión a PostgreSQL (usada por el middleware del servidor Vite, NO por el navegador)
DATABASE_HOST=localhost
# 5433 en el host para no chocar con una instalación local de PostgreSQL
# (que suele ocupar el 5432). Dentro de Docker el contenedor sigue en 5432.
DATABASE_PORT=5433
DATABASE_NAME=ceish_db
DATABASE_USER=ceish_user
DATABASE_PASSWORD=ceish_pass

# Clave HMAC para la cookie de sesión. Debe ser única y secreta en producción.
SESSION_SECRET=replace-with-a-long-random-secret

# MinIO — object storage para los documentos PDF.
# El middleware del servidor Vite sube y firma URLs; el navegador solo recibe URLs.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false
# Tamaño máximo permitido por archivo (MB)
UPLOAD_MAX_MB=15
