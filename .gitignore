# ============================================================
# CEISH Platform - .gitignore
# ============================================================

# Variables de entorno (NUNCA subir al repo)
.env
.env.local
.env.*.local
database/.env

# Node
node_modules/
node_modules.install-failed/
dist/
*.tsbuildinfo
.pnp
.pnp.js

# Prisma
database/node_modules/
database/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Datos de Docker (volúmenes locales)
.docker/

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/settings.json
.idea/
*.swp
*.swo

# Prisma migrations lock (mantener migrations/ pero no este)
database/prisma/migrations/migration_lock.toml
